# Public site URL used for metadata, canonical links, and the sitemap.
# This value is safe to expose to the browser. Do not put secrets in any
# NEXT_PUBLIC_ variable.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Later phases will add server-only secrets here, for example a database
# connection string, authentication secrets, and an AI provider key.
# Those names must NOT use the NEXT_PUBLIC_ prefix.
# Do not commit real values. Copy this file to .env.local for local work.
